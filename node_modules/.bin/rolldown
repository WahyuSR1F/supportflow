#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/proc/cygdrive/c/Users/LEGION/OneDrive/Desktop/project_freelance/supportflow/node_modules/rolldown/bin/node_modules:/proc/cygdrive/c/Users/LEGION/OneDrive/Desktop/project_freelance/supportflow/node_modules/rolldown/node_modules:/proc/cygdrive/c/Users/LEGION/OneDrive/Desktop/project_freelance/supportflow/node_modules:/proc/cygdrive/c/Users/LEGION/OneDrive/Desktop/project_freelance/node_modules:/proc/cygdrive/c/Users/LEGION/OneDrive/Desktop/node_modules:/proc/cygdrive/c/Users/LEGION/OneDrive/node_modules:/proc/cygdrive/c/Users/LEGION/node_modules:/proc/cygdrive/c/Users/node_modules:/proc/cygdrive/c/node_modules:/proc/cygdrive/c/Users/LEGION/OneDrive/Desktop/project_freelance/supportflow/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/proc/cygdrive/c/Users/LEGION/OneDrive/Desktop/project_freelance/supportflow/node_modules/rolldown/bin/node_modules:/proc/cygdrive/c/Users/LEGION/OneDrive/Desktop/project_freelance/supportflow/node_modules/rolldown/node_modules:/proc/cygdrive/c/Users/LEGION/OneDrive/Desktop/project_freelance/supportflow/node_modules:/proc/cygdrive/c/Users/LEGION/OneDrive/Desktop/project_freelance/node_modules:/proc/cygdrive/c/Users/LEGION/OneDrive/Desktop/node_modules:/proc/cygdrive/c/Users/LEGION/OneDrive/node_modules:/proc/cygdrive/c/Users/LEGION/node_modules:/proc/cygdrive/c/Users/node_modules:/proc/cygdrive/c/node_modules:/proc/cygdrive/c/Users/LEGION/OneDrive/Desktop/project_freelance/supportflow/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../rolldown/bin/cli.mjs" "$@"
else
  exec node  "$basedir/../rolldown/bin/cli.mjs" "$@"
fi
